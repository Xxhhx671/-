local function SK() pcall(function() if writefile then writefile(SF, HS:JSONEncode({expiry = getgenv().kawaz_KeyExpiry or {}})) end end) end
local function FK(c) for _, k in ipairs(K) do if k.c == c then return k end end return nil end
local function IK(c)
    local k = FK(c)
    if not k then return false, nil end
    getgenv().kawaz_KeyExpiry = getgenv().kawaz_KeyExpiry or {}
    if k.a then
        getgenv().kawaz_KeyExpiry[c] = os.time() + 100 * 365 * 86400
        SK()
        return true, k
    end
    local e = getgenv().kawaz_KeyExpiry[c]
    if not e then
        local n = os.time()
        e = n + k.h * 3600
        getgenv().kawaz_KeyExpiry[c] = e
        SK()
    end
    if os.time() >= e then return false, k end
    return true, k
end

