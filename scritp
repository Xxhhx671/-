pcall(function()
    if readfile and isfile and isfile(SF) then
        local t = readfile(SF)
        if t and t ~= "" then
            local o, p = pcall(function() return HS:JSONDecode(t) end)
            if o and type(p) == "table" then
                for k, v in pairs(p.expiry or {}) do
                    if getgenv().kawaz_KeyExpiry[k] == nil then getgenv().kawaz_KeyExpiry[k] = v end
